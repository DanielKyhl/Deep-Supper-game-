{
  "name": "deep-supper",
  "productName": "Deep Supper",
  "version": "1.0.0",
  "description": "A small boy, a large sea, and dinner.",
  "main": "electron/main.js",
  "author": "Daniel Kyhl",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win portable",
    "dist:folder": "electron-builder --win dir",
    "test": "node --test \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "build": {
    "appId": "com.danielkyhl.deepsupper",
    "productName": "Deep Supper",
    "copyright": "Daniel Kyhl",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "DeepSupper-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  }
}
